---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/')
const subpath = pathname.match(/[^/]+/g)
const isActive = href === pathname || href === '/' + (subpath?.[0] || '')
---

<a
	href={href}
	class:list={[
		// -mb-px overlaps the header's bottom border, so the active underline sits on it
		'flex items-center -mb-px px-2 text-[15px] border-b-2 transition-colors',
		isActive
			? 'border-indigo-500 text-gray-900 dark:text-white'
			: 'border-transparent text-gray-600 hover:border-gray-300 hover:text-gray-900 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-white',
		className,
	]}
	{...props}
>
	<slot />
</a>
