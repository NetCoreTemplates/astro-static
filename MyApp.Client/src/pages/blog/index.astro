---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import FormattedDate from '../../components/FormattedDate.astro'
import Layout from '../../layouts/Layout.astro'
import { SITE_TITLE } from '../../consts'

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
---

<Layout title={`Blog - ${SITE_TITLE}`}>
	<section class="max-w-5xl mx-auto px-4 py-12">
		<h1 class="text-4xl font-bold tracking-tight mb-10 text-center">Blog</h1>
		<ul class="grid gap-10 sm:grid-cols-2">
			{
				posts.map((post, i) => (
					<li class:list={[{ 'sm:col-span-2 text-center': i === 0 }]}>
						<a href={`/blog/${post.id}`} class="group block">
							{post.data.heroImage && (
								<Image
									width={i === 0 ? 1020 : 720}
									height={i === 0 ? 510 : 360}
									src={post.data.heroImage}
									alt=""
									class="w-full mb-3 rounded-xl transition-shadow group-hover:shadow-lg"
								/>
							)}
							<h2 class:list={['font-bold group-hover:text-indigo-600 dark:group-hover:text-indigo-400', i === 0 ? 'text-3xl' : 'text-xl']}>
								{post.data.title}
							</h2>
							<p class="text-gray-500 dark:text-gray-400">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
