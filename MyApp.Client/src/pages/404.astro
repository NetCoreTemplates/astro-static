---
import Layout from '../layouts/Layout.astro'
---

<!-- Served by .NET for any path without a page, see MapFallbackToFile("404.html") in Program.cs -->
<Layout title="Not Found">
	<div class="py-40 text-center flex flex-col items-center justify-center">
		<div>
			<h1 class="inline-block border-gray-300 dark:border-gray-700 border-r m-0 mr-5 py-2 pr-4 text-2xl font-medium align-top">404</h1>
			<div class="inline-block text-left h-8 align-middle">
				<h2 class="text-sm leading-10 font-normal m-0 p-0">This page could not be found.</h2>
			</div>
		</div>
		<a href="/" class="mt-8 text-sm text-blue-600 dark:text-blue-400 hover:underline">Go back home</a>
	</div>
</Layout>
